{
  "name": "@notchip/expo-panoramic-stitcher",
  "version": "0.5.0",
  "description": "360° / wide panorama image stitching for Expo (SDK 56+) via Swift + Kotlin, powered by OpenCV. No manual OpenCV download required.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "expo-module.config.json",
    "CHANGELOG.md",
    "scripts/download-opencv-ios.js",
    "ios/*.podspec",
    "ios/*.swift",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm"
  ],
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test --passWithNoTests",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "postinstall": "node scripts/download-opencv-ios.js"
  },
  "keywords": [
    "expo",
    "expo-module",
    "react-native",
    "panorama",
    "stitching",
    "opencv",
    "360"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notchip/expo-panoramic-stitcher.git"
  },
  "license": "MIT",
  "author": "Raman-Halder",
  "bugs": {},
  "homepage": "https://github.com/notchip/expo-panoramic-stitcher#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "expo-module-scripts": "^56.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
