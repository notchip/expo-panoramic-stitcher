{
  "name": "@notchip/expo-panoramic-stitcher",
  "version": "0.6.0",
  "description": "360° / wide panorama image stitching for Expo (SDK 56+) via Swift + Kotlin, powered by OpenCV. No manual OpenCV download required.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./capture": {
      "types": "./build/capture/index.d.ts",
      "default": "./build/capture/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "expo-module.config.json",
    "CHANGELOG.md",
    "scripts/download-opencv-ios.js",
    "ios/*.podspec",
    "ios/*.swift",
    "ios/*.h",
    "ios/*.m",
    "ios/*.mm"
  ],
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test --passWithNoTests",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "postinstall": "node scripts/download-opencv-ios.js"
  },
  "keywords": [
    "expo",
    "expo-module",
    "react-native",
    "panorama",
    "stitching",
    "opencv",
    "360"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notchip/expo-panoramic-stitcher.git"
  },
  "license": "MIT",
  "author": "Raman-Halder",
  "bugs": {},
  "homepage": "https://github.com/notchip/expo-panoramic-stitcher#readme",
  "overrides": {
    "@react-native/jest-preset": "0.86.3",
    "expo-module-scripts": {
      "jest-expo": "~57.0.5"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "expo": "~57.0.18",
    "expo-camera": "~57.0.4",
    "expo-haptics": "~57.0.2",
    "expo-module-scripts": "^56.0.3",
    "expo-sensors": "~57.0.2",
    "jest": "^29.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-camera": ">=56.0.0",
    "expo-haptics": ">=56.0.0",
    "expo-sensors": ">=56.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "expo-camera": {
      "optional": true
    },
    "expo-sensors": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  }
}
