# Native build artifacts — never ship these to consumers.
# NOTE: do not use a bare **/build/ here; the root build/ is the compiled JS output.
android/.gradle/
android/build/
android/.cxx/
android/local.properties
ios/Pods/
ios/build/
ios/.xcode.env.local
*.log
# Vendored OpenCV xcframework — consumers fetch it via postinstall; never
# publish it (files whitelists the ios/ dir, so belt-and-braces here).
ios/opencv2.xcframework
ios/.opencv2.xcframework.version
ios/.opencv2.xcframework.zip.partial
ios/.opencv2.xcframework.extract.tmp
